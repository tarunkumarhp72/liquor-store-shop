# =============================================================================
# Git Ignore - MH2 Wine & Spirits
# =============================================================================

# 1. Environment Variables & Secrets (CRITICAL)
.env
.env*.local
.env.development
.env.test
.env.production
!.env.example

# 2. Dependencies
/node_modules
/.pnp
.pnp.js
package-lock.json.bak

# 3. Next.js Build Outputs & Cache
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# 4. Local Testing & Agent Artifacts
.playwright-mcp/
screenshots/
.agents/
skills-lock.json

# 5. Local Data & Migration Scripts
downloaded_images/
scripts/
backups/
/public/uploads/*
!/public/uploads/.gitkeep

# 6. Logs & Debug Files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 7. OS & Editor Files
.DS_Store
Thumbs.db
*.pem
*.key
*.cert
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
