# -----------------------------------------------------------------------------
# MH2 Wine & Spirits - Environment Configuration Template
# -----------------------------------------------------------------------------
# Copy this file to .env.local for local development.
# In production (e.g. Vercel, Render, Railway), set these variables in your deployment dashboard.
# NEVER commit .env or .env.local containing real credentials to Git!

# 1. PostgreSQL Database Connection String (Supabase Pooler)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# 2. Supabase Cloud & Storage Bucket
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_private_key_here
SUPABASE_STORAGE_BUCKET=wine-shop

# 3. Admin Session Secret (Generate a strong 64-character random string)
ADMIN_JWT_SECRET=your_super_secret_64_char_random_jwt_session_signing_key_here

# 4. Store Information & Public Configurations
NEXT_PUBLIC_STORE_NAME="MH2 Wine & Liquor Store"
NEXT_PUBLIC_STORE_PHONE="(403) 769-0061"
NEXT_PUBLIC_STORE_ADDRESS="3106 A 4 St NW, Calgary, AB T2M 3A4"
NEXT_PUBLIC_STORE_HOURS="Open daily 10:00 AM – 2:00 AM"

# 5. External Integration Links
NEXT_PUBLIC_GOOGLE_MAPS_URL=https://share.google/sNkXu4KFg80gvnsCA
NEXT_PUBLIC_UBER_EATS_URL=https://www.ubereats.com/ca/store/mh2-liquor-store/FurwEWDqXG2txmJ3L1Kcig
